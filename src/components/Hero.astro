      >
      <a
        target="_blank"
        rel="noopener noreferrer"
        class="text-[#1d1e1f] hover:bg-[#1d1e1f] hover:text-white bg-[white] dark:bg-[#1d1e1f] dark:text-white dark:hover:brightness-125 py-1 px-4 flex items-center gap-2 text-sm rounded-md transition-all dark:hover:text-green-500"
        href="https://github.com/josecontrerasmt"
        ><i class="bx bxl-github text-4xl"></i>GitHub</a
      >
      <a
        target="_blank"
        rel="noopener noreferrer"
        class="text-[#1d1e1f] hover:bg-[#1d1e1f] hover:text-white bg-[white] dark:bg-[#1d1e1f] dark:text-white dark:hover:brightness-125 py-1 px-4 flex items-center gap-2 text-sm rounded-md transition-all dark:hover:text-green-500"
        href="https://www.linkedin.com/in/jose-contreras-martinez-34a4bb2ab/"
        ><i class="bx bxl-linkedin-square text-4xl"></i>LinkedIn</a
      >
    </div>

    <span class="block mt-10 w-full border-b-2 border-gray-400 opacity-60"
    ></span>
  </div>
  <img
    class="hidden dark:block md:col-span-4 order-1 md:order-2 w-[280px] md:w-[500px] rounded-full object-cover mx-auto"
