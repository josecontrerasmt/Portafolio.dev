---

<section id="proyectos" class="mt-16 pt-20">
  <div>
    <!--Experiencia profecional!-->
    <h2 class="tituloSecundario">
      <i class="bx bxs-briefcase-alt-2"></i> Experiencia Profesional
    </h2>
    <section class="mt-10 font-semibold w-full mx-auto">
      <ol
        class="relative flex flex-col gap-5 md:gap-7 border-s border-black dark:border-green-500"
      >
        <Trabajo data={experiencia.egas} client:load />
        <Trabajo data={experiencia.realidario} client:load />
        <Trabajo data={experiencia.freelance} client:load />
      </ol>
    </section>
  </div>

  <div class="mt-20">
    <!--Proyectos-->
    <h2 class="tituloSecundario">
      <i class="bx bx-laptop"></i> Proyectos personales
    </h2>
    <section class="grid md:grid-cols-2 lg:grid-cols-3 mt-10 gap-5">
      {
        proyectos.map((item) => (
          <div class="w-full bg-white dark:bg-[#121313] dark:border dark:border-black shadow-sm dark:shadow-black p-4 rounded-md flex flex-col justify-between gap-5">
            <div class="space-y-6">
              <img
                class="object-cover rounded-md h-48 w-full object-bottom"
                src={item.imagen}
                alt={item.tituloProyecto}
              />
              <div class="space-y-3 mt-2">
                <div class="text-center space-x-2 flex gap-2 flex-wrap justify-center font-semibold">
                  {item.herraminetas.map((item) => (
                    <Tools textSize="13px" item={item} client:load />
                  ))}
                </div>
                <h3 class="text-xl font-bold text-center text-black dark:text-green-400">
                  {item.tituloProyecto}
                </h3>
                <p class="font-normal text-[14px]">{item.descripcion}</p>
              </div>
            </div>
            <div class="flex justify-end">
              {/* <a
                target="_blank"
                rel="noopener noreferrer"
                href={item.link}
                class="dark:hover:bg-[#212121] transition-all cursor-pointer py-1.5 px-3 rounded-md font-semibold text-sm text-center flex items-center gap-1 text-gray-400 hover:text-black dark:hover:text-gray-100"
              >
                <i class="bx bx-code-alt text-black dark:text-green-400" />
                Código
              </a> */}
              <a
                target="_blank"
                rel="noopener noreferrer"
                href={item.link}
                class="dark:hover:bg-[#212121] transition-all cursor-pointer py-1.5 px-3 rounded-md font-semibold text-sm text-center flex items-center gap-1 text-gray-400 hover:text-black dark:hover:text-gray-100"
              >
                <i class="bx bx-link-alt text-black dark:text-green-400" />
                Demo
              </a>
            </div>
          </div>
        ))
      }
    </section>
  </div>

  <div class="mt-20">
    <!--Deseños web-->
    <h2 class="tituloSecundario"><i class="bx bx-paint"></i> UI & UX</h2>
    <p class="mt-2 font-semibold text-center text-[14px] md:text-lg w-full md:w-[80%] mx-auto">
      Algunas interfaces desarrolladas para proyectos personales y
      profesionales, enfocadas en crear experiencias limpias, intuitivas y
      responsivas.
    </p>
    <Carrusel />
  </div>
</section>

<style>
  p {
    margin-bottom: 25px;
  }
  .tituloSecundario {
    font-weight: bold;
    font-size: 1.8em;
    text-align: center;
    color: var(--tituloSecundario);
  }
</style>
