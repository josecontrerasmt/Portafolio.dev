<style>
  p {
    margin-bottom: 25px;
  }
  .tituloSecundario {
    font-weight: bold;
    font-size: 1.8em;
    text-align: center;
    color: #49de80;
  }
  .textoContenedor:hover span {
    color: #6df49e;
    transition: color 0.4s ease;
  }
</style>
